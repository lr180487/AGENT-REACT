ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/react_rag
# SQLite fallback: sqlite:///./react_rag.db

# LLM
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# RAG
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Tavily (optional)
TAVILY_API_KEY=

# Google Programmable Search / Custom Search JSON API (optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_SAFESEARCH=active

# Celery / Redis
# Redis local: redis://localhost:6379/0
# Upstash Redis for Celery: use the Redis TLS endpoint (rediss://...), not the REST URL.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AGENT_TASK_SOFT_TIME_LIMIT=300
AGENT_TASK_TIME_LIMIT=330
RECONNECT_GRACE_SECONDS=30

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
